@model IEnumerable<Backend.Models.Usuarios>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.PrimerNombre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.SegundoNombre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PrimerApellido)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.SegundoApellido)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Edad)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Correo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Contrasena)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.rol)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ocupacion)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.fechaderegistro)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.PrimerNombre)
            </td>
            <td>
                @Html.DisplayFor(model => item.SegundoNombre)
            </td>
            <td>
                @Html.DisplayFor(model => item.PrimerApellido)
            </td>
            <td>
                @Html.DisplayFor(model => item.SegundoApellido)
            </td>
            <td>
                @Html.DisplayFor(model => item.Edad)
            </td>
            <td>
                @Html.DisplayFor(model => item.Correo)
            </td>
            <td>
                @Html.DisplayFor(model => item.Contrasena)
            </td>
            <td>
                @Html.DisplayFor(model => item.rol)
            </td>
            <td>
                @Html.DisplayFor(model => item.ocupacion)
            </td>
            <td>
                @Html.DisplayFor(model => item.fechaderegistro)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.IdPersonas">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.IdPersonas">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.IdPersonas">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
